# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb
# Notebooks under experiments/notebooks/ are deliverables, not scratch: they are
# the written-up evaluation. The blanket rule above stays for stray notebooks
# elsewhere, which carry stored outputs and produce unreviewable diffs. Keep
# committed notebooks output-free for the same reason.
!experiments/notebooks/*.ipynb

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# Compiled test executables (keep source .cpp files)
tests/cpp/test_*
!tests/cpp/test_*.cpp
tests/python/test_*
!tests/python/test_*.py

# Documentation
docs/_build/
*.pdf.bak

# Text files
*.pdf

# Bench results and large generated data — keep the .gitkeep placeholders
tests/bench/results/*.csv
tests/bench/results/plots/

# Local data directory — sample/benchmark files, not test fixtures
/data/

# Large experimental results (root-level only; bench results are handled above)
/results/
experiments/output/
*.log

# Temporary files
*.tmp
*.temp
tmp/
temp/
old_code/

# OS files
Thumbs.db
.DS_Store

# Session and local notes (keep Claude config)
.claude/session-notes.md
.claude
.claudeignore

# MkDocs build output
site/

*.md
!tests/bench/README.md
!CLAUDE.md
!README.md
!TODO.md
!src/cpp/tools/README.md
!docs/*.md
!mkdocs.yml

# Experiment outputs — keep harnesses, CSVs, logs and pattern sets; never the
# generated l-EDS or index directories (regenerate by re-running the harness).

# Experiments live entirely outside this repo, under ~/Data/experiments/biofmi
# (specs, the driver, oracles, notebooks, runs, and the covid294 reference
# bundle). Nothing about measuring is versioned here; this rule is a backstop in
# case a stray experiments/ directory reappears.
experiments/
